# Copie para .env (o .env NÃO vai para o git) e ajuste.

# --- Cadastros API ---
# mock = dados simulados (sem credencial) | real = API de produção
CADASTROS_API_MODE=mock
CADASTROS_API_URL=https://cadastros.postosopcao.com.br
# Preferencial: chave de leitura (header X-Api-Key)
CADASTROS_API_KEY=
# Alternativa: OAuth2 client_credentials
CADASTROS_CLIENT_ID=
CADASTROS_CLIENT_SECRET=
CADASTROS_SCOPE=cadastros-api
CADASTROS_PAGE_SIZE=200
DIAS_REPROCESSAMENTO=3

# --- Destinos ---
# Local: pasta montada no container. Na AWS: s3://nome-do-bucket/bronze
BRONZE_URI=/opt/airflow/data/bronze
WAREHOUSE_PASSWORD=troque-esta-senha

# --- Airflow ---
AIRFLOW_UID=50000
# Gere um valor aleatório longo (ex.: python -c "import secrets; print(secrets.token_urlsafe(48))")
AIRFLOW__API_AUTH__JWT_SECRET=troque-este-segredo
# SÓ para uso local: entra na interface sem login. Na EC2, remova e configure usuários.
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_ALL_ADMINS=True

# --- API B2Click (retaguarda) ---
B2CLICK_URL=https://retaguarda.b2click.com/b2click/rest/TModuloAPIb2click
B2CLICK_ENTIDADE=
B2CLICK_USUARIO=
B2CLICK_TOKEN=

# --- Destino dos dados ---
# postgres (padrão, banco local do Docker) | bigquery
DESTINO=postgres
# dbt: dev (PostgreSQL) | bigquery
DBT_TARGET=dev
# Só para DESTINO=bigquery (ver docs/tutorial-google.html):
BQ_PROJETO=
BQ_LOCAL=southamerica-east1
# BRONZE_URI=gs://<bucket>/bronze
# GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/secrets/gcp-pipeline.json
