table fct_conciliacao_tanque_diario
	lineageTag: 8adfb1ff-ac0a-483f-b97e-8af54558837a

	measure 'Diferença (L)' = SUM(fct_conciliacao_tanque_diario[diferenca_litros])
		formatString: #,0.0
		lineageTag: a771d4c9-c4c6-4359-a25e-01fa543c1011

	measure 'Diferença %' = DIVIDE(SUM(fct_conciliacao_tanque_diario[consumo_medido]) - SUM(fct_conciliacao_tanque_diario[litros_vendidos]), SUM(fct_conciliacao_tanque_diario[litros_vendidos]))
		formatString: 0.00%
		lineageTag: 14e4ffd8-45f0-4cde-9a1e-b9e1729954d2

	measure 'Aferição (L)' = SUM(fct_conciliacao_tanque_diario[afericao_litros])
		formatString: #,0
		lineageTag: f6f42ea0-d834-470f-8f39-ffaa36aeddc7

	measure 'Dias fora da tolerância' = CALCULATE(COUNTROWS(fct_conciliacao_tanque_diario), fct_conciliacao_tanque_diario[status] = "fora_tolerancia")
		formatString: 0
		lineageTag: 333f33b4-be7b-451e-9248-9d1733f38dca

